# SOLODESK AI — Environment Configuration Example (Never commit real secrets)
PORT=3000
NODE_ENV=development
SOLODESK_SQLITE_PATH=./data/solodesk-saas.sqlite

# Optional server-side Gemini API key (leave empty for offline draft mode or user BYOK session key)
GEMINI_API_KEY=

# Optional hosted PostgreSQL / Supabase connection (when migrating beyond single-node SQLite)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
